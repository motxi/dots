set $mod Mod1

include ~/.config/i3/theme.conf

font pango:monospace 12

exec_always --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id killall picom; picom --daemon
exec_always --no-startup-id killall dunst; dunst --config ~/.config/dunst/config
exec_always --no-startup-id headsetcontrol --light 0 && headsetcontrol --sidetone 128 

exec --no-startup-id ~/.scripts/screen-layout.sh
exec --no-startup-id dex --autostart --environment i3

exec --no-startup-id xset b off

floating_modifier $mod

floating_minimum_size 75 x 50
floating_maximum_size -1 x -1

for_window [window_role="bubble"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable

for_window [class="pavucontrol"] floating enable, sticky enable
for_window [class="vesktop" title="^(?!.*(Discord|Vesktop)).*$"] floating enable, sticky enable

bindsym $mod+w kill

set $refresh_i3status killall -SIGUSR1 i3status

# Audio Controls
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.scripts/debounce-volume.sh 1%+ && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.scripts/debounce-volume.sh 1%- && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_AUDIO_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_AUDIO_SOURCE@ toggle && $refresh_i3status

# Programs and Scripts
bindsym $mod+Return exec --no-startup-id kitty
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym Print exec --no-startup-id ~/.scripts/take-screenshot.sh

# i3-Specific Controls
bindsym $mod+Control+c reload
bindsym $mod+Control+r restart
bindsym $mod+Control+e exec --no-startup-id ~/.scripts/power-menu.sh

# Window Modes
bindsym $mod+f fullscreen toggle
bindsym $mod+s sticky toggle
bindsym $mod+a floating toggle; sticky enable

bindsym $mod+Shift+s layout toggle split
bindsym $mod+Shift+t layout toggle tabbed

# Window Splits
bindsym $mod+Shift+h split h
bindsym $mod+Shift+v split v

# Window Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Control+a focus mode_toggle

# Window Movement
bindsym $mod+Control+h move left
bindsym $mod+Control+j move down
bindsym $mod+Control+k move up
bindsym $mod+Control+l move right

# Workspaces
set $workspace_1 "1"
set $workspace_2 "2"
set $workspace_3 "3"
set $workspace_4 "4"
set $workspace_5 "5"

bindsym $mod+1 workspace number $workspace_1
bindsym $mod+2 workspace number $workspace_2
bindsym $mod+3 workspace number $workspace_3
bindsym $mod+4 workspace number $workspace_4
bindsym $mod+5 workspace number $workspace_5

bindsym $mod+Control+1 move container to workspace number $workspace_1
bindsym $mod+Control+2 move container to workspace number $workspace_2
bindsym $mod+Control+3 move container to workspace number $workspace_3
bindsym $mod+Control+4 move container to workspace number $workspace_4
bindsym $mod+Control+5 move container to workspace number $workspace_5
