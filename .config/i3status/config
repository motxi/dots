general {
    output_format = "i3bar"

    interval = 1
    colors = false
}

order += "volume master"
order += "wireless _first_"
order += "ethernet _first_"
order += "disk /"
order += "memory"
order += "load"
order += "time"

volume master {
    format = "%volume"
    format_muted = "%volume (Muted)"
}

wireless _first_ {
    format_up = "%ip (%quality @ %essid)"
    format_down = "Down"
}

ethernet _first_ {
    format_up = "%ip"
    format_down = "Down"
}

disk "/"{
    format = "%used (%percentage_used)"
}

memory {
    format = "%used (%percentage_used)"
    unit = "Gi"
}

load {
    format = "%1min %5min"
}

time {
    format = "%Y-%m-%d %a %H:%M:%S "
}
